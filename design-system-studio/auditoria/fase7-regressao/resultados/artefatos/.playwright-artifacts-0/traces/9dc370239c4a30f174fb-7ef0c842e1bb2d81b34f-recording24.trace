,"fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-check","aria-hidden":"true"},["path",{"d":"M20 6 9 17l-5-5"}]],"As mesmas escolhas do modo guiado: alterne quando quiser."]]],["BUTTON",{"type":"button","class":"ui-btn ui-btn--secondary ui-btn--lg","data-testid":"start-free"},"Abrir todos os módulos",["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-arrow-right"},["path",{"d":"M5 12h14"}],["path",{"d":"m12 5 7 7-7 7"}]]]]],["SECTION",{"class":"ui-section","style":"margin-top: var(--sp-8);"},["DIV",{"class":"ui-section__head"},["DIV",{},["H2",{"class":"ui-section__title"},"Primeiro o esqueleto, depois o acabamento"],["P",{"class":"ui-section__desc"},"A ordem importa: decidir a estrutura antes das cores evita retrabalho com a IA."]]],["OL",{"class":"home-steps"},["LI",{},["SMALL",{},"1 · Esqueleto"],["STRONG",{},"Estrutura do site"],["SPAN",{},"Tipo de site, páginas de entrada e onde ficam header, sidebar e conteúdo — no computador e no celular."]],["LI",{},["SMALL",{},"2 · Identidade"],["STRONG",{},"Cores e tipografia"],["SPAN",{},"Uma paleta central com tokens que todos os componentes herdam."]],["LI",{},["SMALL",{},"3 · Componentes"],["STRONG",{},"Menus, botões, cards…"],["SPAN",{},"Escolha e personalize cada peça, com edição visual."]],["LI",{},["SMALL",{},"4 · Entrega"],["STRONG",{},"Master Prompt"],["SPAN",{},"Especificação completa em texto e JSON, pronta para a IA construir o site."]]]]]]],[[2,374]]]],[[2,377]]]],"viewport":{"width":1440,"height":900},"timestamp":85196.581,"wallTime":1793664358466,"collectionTime":60.200000000186265,"resourceOverrides":[],"isMainFrame":true}}
