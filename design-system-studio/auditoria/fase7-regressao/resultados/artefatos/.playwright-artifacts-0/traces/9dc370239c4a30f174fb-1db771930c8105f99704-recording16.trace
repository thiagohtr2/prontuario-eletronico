{"type":"before","callId":"call@1002","startTime":76828.999,"class":"Frame","method":"evaluateExpression","params":{"expression":"css => {\n    const sheet = new CSSStyleSheet();\n    sheet.replaceSync(css);\n    const vars = {};\n    for (const rule of Array.from(sheet.cssRules)) {\n      if (rule instanceof CSSStyleRule && rule.selectorText === ':root') {\n        for (const name of Array.from(rule.style)) if (name.startsWith('--')) vars[name] = rule.style.getPropertyValue(name).trim();\n      }\n    }\n    return {\n      rules: sheet.cssRules.length,\n      vars\n    };\n  }","isFunction":true,"arg":{"value":{"s":"/*\n * Projeto Regressão — CSS de referência gerado pelo Atelier UI.\n * Tokens da identidade global. Use estas variáveis em todos os componentes.\n */\n:root {\n  --color-primary: #95d5b2;\n  --color-primary-hover: #a0d9ba;\n  --color-primary-active: #a8ddc0;\n  --color-on-primary: #111114;\n  --color-primary-soft: #324b3e;\n  --color-secondary: #52b788;\n  --color-on-secondary: #111114;\n  --color-accent: #f4a261;\n  --color-on-accent: #111114;\n  --color-bg: #0b1410;\n  --color-bg-alt: #1a221e;\n  --color-surface: #13201a;\n  --color-surface-alt: #24302a;\n  --color-text: #e3f2e9;\n  --color-text-muted: #919e97;\n  --color-text-disabled: #5d6862;\n  --color-placeholder: #77837d;\n  --color-border: #39443f;\n  --color-border-strong: #5a635f;\n  --color-focus-ring: #95d5b2;\n  --color-hover: #26322c;\n  --color-active: #343f3a;\n  --color-pressed: #424d48;\n  --color-selected: #375345;\n  --color-selected-text: #95d5b2;\n  --color-disabled: #2b3631;\n  --color-disabled-text: #717e77;\n  --color-success: #16a34a;\n  --color-success-bg: #143a24;\n  --color-warning: #d97706;\n  --color-warning-bg: #3b3116;\n  --color-error: #e45757;\n  --color-error-bg: #3b211c;\n  --color-info: #5686ef;\n  --color-info-bg: #172d44;\n  --color-link: #95d5b2;\n  --color-link-hover: #a5dbbe;\n  --color-icon: #adbbb3;\n  --color-nav-bg: #13201a;\n  --color-nav-text: #cbcecd;\n  --color-nav-active: #343f3a;\n  --color-nav-active-text: #ffffff;\n  --color-gradient-from: #95d5b2;\n  --color-gradient-to: #dc9257;\n  --gradient-brand: none;\n  --font-heading: 'Inter Variable', Inter, system-ui, sans-serif;\n  --font-body: 'Inter Variable', Inter, system-ui, sans-serif;\n  --font-size-base: 15px;\n  --font-weight-heading: 650;\n  --font-weight-body: 400;\n  --radius-sm: 6px;\n  --radius-md: 8px;\n  --radius-lg: 12px;\n  --border-width: 1px;\n  --shadow-surface: none;\n  --space-unit: 8px;\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-7: 32px;\n  --space-8: 40px;\n  color-scheme: dark;\n}\n\n*, *::before, *::after { box-sizing: border-box; }\n\nhtml { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }\n\nbody {\n  margin: 0;\n  background: var(--color-bg);\n  color: var(--color-text);\n  font-family: var(--font-body);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-body);\n  line-height: 1.5;\n  overflow-wrap: anywhere;\n}\n\nh1, h2, h3, h4 { font-family: var(--font-heading); font-weight: var(--font-weight-heading); line-height: 1.2; }\n\na { color: var(--color-link); }\na:hover { color: var(--color-link-hover); }\n\nimg, video, svg { max-width: 100%; height: auto; }\n\n:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n\n.btn-primary {\n  min-height: 44px;\n  padding: 0 var(--space-4);\n  border: 0;\n  border-radius: var(--radius-md);\n  background: var(--color-primary);\n  color: var(--color-on-primary);\n  font: inherit;\n  font-weight: 600;\n}\n.btn-primary:hover { background: var(--color-primary-hover); }\n.btn-primary:active { background: var(--color-primary-active); }\n.btn-primary:disabled { background: var(--color-disabled); color: var(--color-disabled-text); }\n\n.surface {\n  background: var(--color-surface);\n  border: var(--border-width) solid var(--color-border);\n  border-radius: var(--radius-lg);\n  box-shadow: var(--shadow-surface);\n}\n\ninput, select, textarea {\n  font: inherit;\n  min-height: 44px;\n  border: var(--border-width) solid var(--color-border-strong);\n  border-radius: var(--radius-md);\n  background: var(--color-surface);\n  color: var(--color-text);\n}\ninput::placeholder, textarea::placeholder { color: var(--color-placeholder); }\n\n@media (max-width: 599px) {\n  input, select, textarea { font-size: 16px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }\n}\n"},"handles":[]}},"stepId":"pw:api@62"}
