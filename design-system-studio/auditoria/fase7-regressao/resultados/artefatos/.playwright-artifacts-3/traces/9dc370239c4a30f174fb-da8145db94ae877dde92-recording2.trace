{"type":"before","callId":"call@128","startTime":33774.295,"class":"Frame","method":"evaluateExpression","params":{"expression":"NOT => {\n    const els = Array.from(document.querySelectorAll('button, a.ui-btn, [role=button]')).filter(e => {\n      const r = e.getBoundingClientRect();\n      return r.width > 4 && r.height > 4 && getComputedStyle(e).visibility !== 'hidden' && !e.closest(NOT);\n    });\n    const boxes = els.map(e => ({\n      e,\n      r: e.getBoundingClientRect(),\n      n: (e.getAttribute('aria-label') || e.textContent || '').trim().replace(/\\s+/g, ' ').slice(0, 30)\n    }));\n    const issues = [];\n    for (let i = 0; i < boxes.length; i++) for (let j = i + 1; j < boxes.length; j++) {\n      const a = boxes[i],\n        b = boxes[j];\n      if (a.e.contains(b.e) || b.e.contains(a.e)) continue;\n      const ix = Math.min(a.r.right, b.r.right) - Math.max(a.r.left, b.r.left);\n      const iy = Math.min(a.r.bottom, b.r.bottom) - Math.max(a.r.top, b.r.top);\n      if (ix > 1 && iy > 1) issues.push(`sobrepostos: \"${a.n}\" × \"${b.n}\"`);else if (iy > Math.min(a.r.height, b.r.height) / 2) {\n        const gap = Math.max(b.r.left - a.r.right, a.r.left - b.r.right);\n        if (gap >= 0 && gap < 4) issues.push(`grudados: \"${a.n}\" | \"${b.n}\" (${gap.toFixed(1)} px)`);\n      } else if (ix > Math.min(a.r.width, b.r.width) / 2) {\n        const gap = Math.max(b.r.top - a.r.bottom, a.r.top - b.r.bottom);\n        if (gap >= 0 && gap < 4) issues.push(`grudados: \"${a.n}\" / \"${b.n}\" (${gap.toFixed(1)} px)`);\n      }\n    }\n    return issues;\n  }","isFunction":true,"arg":{"value":{"s":".ui-option__hit, .nvs-card__select, .ui-option__media, .nvs-card__preview, [data-testid=\"phone-preview\"], [data-testid=\"phone-thumb\"], [data-testid=\"identity-preview\"], [data-testid=\"live-preview\"], .ui-segmented, [role=tablist], .lay-ds, .gd-footer, .shell-topbar, #studio-sidebar, .cmp-nav, [aria-hidden=\"true\"]"},"handles":[]}},"stepId":"pw:api@55"}
