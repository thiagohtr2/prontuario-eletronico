{"type":"before","callId":"call@1110","startTime":85756.446,"class":"Frame","method":"evaluateExpression","params":{"expression":"css => {\n    const sheet = new CSSStyleSheet();\n    sheet.replaceSync(css);\n    const vars = {};\n    for (const rule of Array.from(sheet.cssRules)) {\n      if (rule instanceof CSSStyleRule && rule.selectorText === ':root') {\n        for (const name of Array.from(rule.style)) if (name.startsWith('--')) vars[name] = rule.style.getPropertyValue(name).trim();\n      }\n    }\n    return {\n      rules: sheet.cssRules.length,\n      vars\n    };\n  }","isFunction":true,"arg":{"value":{"s":"/*\n * Loja Aurora — CSS de referência gerado pelo Atelier UI.\n * Tokens da identidade global. Use estas variáveis em todos os componentes.\n */\n:root {\n  --color-primary: #18181b;\n  --color-primary-hover: #161618;\n  --color-primary-active: #131316;\n  --color-on-primary: #ffffff;\n  --color-primary-soft: #e3e3e4;\n  --color-secondary: #52525b;\n  --color-on-secondary: #ffffff;\n  --color-accent: #2563eb;\n  --color-on-accent: #ffffff;\n  --color-bg: #ffffff;\n  --color-bg-alt: #f6f6f6;\n  --color-surface: #ffffff;\n  --color-surface-alt: #f5f5f5;\n  --color-text: #18181b;\n  --color-text-muted: #707072;\n  --color-text-disabled: #a7a7a8;\n  --color-placeholder: #8c8c8d;\n  --color-border: #e6e6e6;\n  --color-border-strong: #c7c7c7;\n  --color-focus-ring: #18181b;\n  --color-hover: #f4f4f4;\n  --color-active: #ebebeb;\n  --color-pressed: #e0e0e0;\n  --color-selected: #e3e3e4;\n  --color-selected-text: #18181b;\n  --color-disabled: #f0f0f0;\n  --color-disabled-text: #979798;\n  --color-success: #117e39;\n  --color-success-bg: #e3f4e9;\n  --color-warning: #a85c04;\n  --color-warning-bg: #faefe1;\n  --color-error: #dc2626;\n  --color-error-bg: #fbe5e5;\n  --color-info: #2563eb;\n  --color-info-bg: #e5ecfd;\n  --color-link: #18181b;\n  --color-link-hover: #141417;\n  --color-icon: #525254;\n  --color-nav-bg: #ffffff;\n  --color-nav-text: #4b4b4d;\n  --color-nav-active: #e3e3e4;\n  --color-nav-active-text: #18181b;\n  --color-gradient-from: #18181b;\n  --color-gradient-to: #3b73ed;\n  --gradient-brand: none;\n  --font-heading: 'Inter Variable', Inter, system-ui, sans-serif;\n  --font-body: 'Inter Variable', Inter, system-ui, sans-serif;\n  --font-size-base: 15px;\n  --font-weight-heading: 650;\n  --font-weight-body: 400;\n  --radius-sm: 6px;\n  --radius-md: 8px;\n  --radius-lg: 12px;\n  --border-width: 1px;\n  --shadow-surface: none;\n  --space-unit: 8px;\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-7: 32px;\n  --space-8: 40px;\n  color-scheme: light;\n}\n\n*, *::before, *::after { box-sizing: border-box; }\n\nhtml { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }\n\nbody {\n  margin: 0;\n  background: var(--color-bg);\n  color: var(--color-text);\n  font-family: var(--font-body);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-body);\n  line-height: 1.5;\n  overflow-wrap: anywhere;\n}\n\nh1, h2, h3, h4 { font-family: var(--font-heading); font-weight: var(--font-weight-heading); line-height: 1.2; }\n\na { color: var(--color-link); }\na:hover { color: var(--color-link-hover); }\n\nimg, video, svg { max-width: 100%; height: auto; }\n\n:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n\n.btn-primary {\n  min-height: 44px;\n  padding: 0 var(--space-4);\n  border: 0;\n  border-radius: var(--radius-md);\n  background: var(--color-primary);\n  color: var(--color-on-primary);\n  font: inherit;\n  font-weight: 600;\n}\n.btn-primary:hover { background: var(--color-primary-hover); }\n.btn-primary:active { background: var(--color-primary-active); }\n.btn-primary:disabled { background: var(--color-disabled); color: var(--color-disabled-text); }\n\n.surface {\n  background: var(--color-surface);\n  border: var(--border-width) solid var(--color-border);\n  border-radius: var(--radius-lg);\n  box-shadow: var(--shadow-surface);\n}\n\ninput, select, textarea {\n  font: inherit;\n  min-height: 44px;\n  border: var(--border-width) solid var(--color-border-strong);\n  border-radius: var(--radius-md);\n  background: var(--color-surface);\n  color: var(--color-text);\n}\ninput::placeholder, textarea::placeholder { color: var(--color-placeholder); }\n\n@media (max-width: 599px) {\n  input, select, textarea { font-size: 16px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }\n}\n"},"handles":[]}},"stepId":"pw:api@54"}
